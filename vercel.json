{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/patrimonio/:path*",
      "destination": "https://descartes-dkp.vercel.app/:path*"
    },
    {
      "source": "/rh/:path*",
      "destination": "https://rh-dkp.vercel.app/:path*"
    },
    {
      "source": "/financeiro/:path*",
      "destination": "https://financeiro-dkp.vercel.app/:path*"
    },
    {
      "source": "/secretaria/:path*",
      "destination": "https://secretaria-dkp.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ]
}
